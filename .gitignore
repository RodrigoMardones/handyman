# Regenerable: dependencies and build output (npm install / npm run build)
node_modules/
handyman/dist/
handyman/.pack-staging/
apps/web/.next/
apps/web/next-env.d.ts
apps/web/tsconfig.tsbuildinfo

# Python bytecode and test caches
__pycache__/
*.pyc
.pytest_cache/

# macOS noise
.DS_Store

# Handyman harness: all state (feature_list, progress, backlog, docs, sprints,
# index.md) stays in the repo as agent context; only upgrade backups are volatile.
.handyman/.upgrade-backups/

# graphify: graph.json / graph.html / GRAPH_REPORT.md / manifest stay in the
# repo as shared context; ignore transient pipeline files, the machine-specific
# interpreter/root pointers, the regenerable AST cache (absolute local paths)
# and the personal token-usage telemetry.
graphify-out/.graphify_*
graphify-out/.needs_update
graphify-out/cache/
graphify-out/cost.json

# Third-party skills installed locally by the skills CLI. Only skills that ship
# an explicit license are tracked (redistribution right); the rest stay local.
.agents/skills/*

# Local editor / MCP config (machine-specific, may hold endpoints or keys)
.vscode/

# Local secrets (LLM provider API keys for the toolBox — never committed)
.env

# skills and tools config (may hold secrets, but is tracked for reproducibility)
skills-lock.json