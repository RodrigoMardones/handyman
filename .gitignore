# Regenerable: dependencies and build output (npm install / npm run build)
node_modules/
handyman/dist/

# Python bytecode and test caches
__pycache__/
*.pyc
.pytest_cache/

# macOS noise
.DS_Store

# Handyman harness: all state (feature_list, progress, backlog, docs, sprints,
# index.md) stays in the repo as agent context; only upgrade backups are volatile.
.handyman/.upgrade-backups/

# graphify: graph.json / graph.html / GRAPH_REPORT.md / manifest / cache stay in
# the repo as shared context; ignore transient pipeline files and the
# machine-specific interpreter/root pointers.
graphify-out/.graphify_*
graphify-out/.needs_update

# Local editor / MCP config (machine-specific, may hold endpoints or keys)
.vscode/

# Local secrets (LLM provider API keys for the toolBox — never committed)
.env