{
  "name": "handyman-harness",
  "version": "3.5.0",
  "description": "Handyman agent-harness toolchain (TypeScript/Node).",
  "author": "Rodrigo Mardones",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./dist/toolbox.js",
    "./state": "./dist/toolbox_state.js",
    "./toolbox": "./dist/toolbox.js",
    "./mcp": "./dist/mcp.js",
    "./assets/*": "./assets/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b",
    "pack:npm": "node scripts/pack_npm.mjs",
    "test": "vitest run",
    "toolbox:serve": "node dist/toolbox.js serve",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@handyman/toolbox-core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ajv": "^8.20.0",
    "vis-network": "^9.1.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "@types/node": "^26.1.1",
    "esbuild": "^0.28.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
