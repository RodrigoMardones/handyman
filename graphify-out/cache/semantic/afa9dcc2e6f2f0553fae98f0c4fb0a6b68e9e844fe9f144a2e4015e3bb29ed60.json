{"nodes": [{"id": "references_graphify_context_layer", "label": "Graphify Context Layer", "file_type": "concept", "source_file": "references/graphify.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A persistent on-disk knowledge graph queried for context instead of re-reading the codebase each session; additive, so when missing every role falls back to normal reading and the harness never depends on it."}, {"id": "references_graphify_install_rule", "label": "Graphify Install Rule", "file_type": "concept", "source_file": "references/graphify.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "graphify must be installed for the context layer to work; the command is 'graphify' but the package is 'graphifyy' (uv tool install graphifyy / pip install graphifyy). The verifier only warns when absent, never fails."}, {"id": "references_graphify_freshness", "label": "Graph Freshness Maintenance", "file_type": "concept", "source_file": "references/graphify.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A stale graph misleads, so keep it current: the post-commit hook re-runs deterministic free AST extraction on code, while semantic doc extraction costs tokens and runs on demand via /graphify --update."}, {"id": "references_graphify_query", "label": "graphify query Command", "file_type": "concept", "source_file": "references/graphify.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Roles prefer graphify query / path / explain over a cold read and quote the returned source_location when citing a fact."}, {"id": "references_graphify_graph_json", "label": "graphify-out/graph.json Graph Data", "file_type": "concept", "source_file": "references/graphify.md", "source_location": null, "source_url": 