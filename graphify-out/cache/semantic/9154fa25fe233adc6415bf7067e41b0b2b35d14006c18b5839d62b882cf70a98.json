{"nodes": [{"id": "docs_analisis_inconsistencia_bootstrap_doc", "label": "Analisis: inconsistencia del bootstrap entre modelos", "file_type": "document", "source_file": "docs/analisis-inconsistencia-bootstrap.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_analisis_inconsistencia_bootstrap_single_bootstrap_path", "label": "scaffold.sh as Single Bootstrap Path", "file_type": "rationale", "source_file": "docs/analisis-inconsistencia-bootstrap.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bootstrap inconsistency across models is a design property, not a model bug: multiple prose sources of truth disagree with the deterministic script, so all paths must collapse to scaffold.sh + feature.py add."}, {"id": "docs_analisis_inconsistencia_bootstrap_live_schema_validation", "label": "Live Schema Validation of feature_list.json", "file_type": "concept", "source_file": "docs/analisis-inconsistencia-bootstrap.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "additionalProperties:false in the schema rejects invented keys like start_date/close_date, but only once the verifier validates the live state instead of only the templates."}, {"id": "docs_analisis_inconsistencia_bootstrap_state_machine_not_timeline", "label": "Feature List Is a State Machine, Not a Timeline", "file_type": "rationale", "source_file": "docs/analisis-inconsistencia-bootstrap.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Features carry no dates; chronology lives in progress/current.md and progress/history.md. Making this explicit removes the reasonable hallucination that led models to invent date fields."}], "edges": [{"source": "docs_analisis_inconsistencia_bootstrap_doc", "target": "docs_analisis_inconsistencia_boot