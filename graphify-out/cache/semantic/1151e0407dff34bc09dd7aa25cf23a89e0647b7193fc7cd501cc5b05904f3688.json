{"nodes": [{"id": "references_toolbox", "label": "ToolBox: Multi-Harness Observation", "file_type": "document", "source_file": "handyman/references/toolbox.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_toolbox_registry", "label": "ToolBox Registry (registry.json)", "file_type": "concept", "source_file": "handyman/references/toolbox.md", "source_location": "Registry", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The registry stores ONLY project_root plus the registration date; names, versions, counts, and sessions are read live on every query, so there is no mirrored state to drift. Unreadable roots degrade to an UNREADABLE signal, never a crash."}, {"id": "references_toolbox_observer", "label": "ToolBox Live Observer (toolbox serve)", "file_type": "concept", "source_file": "handyman/references/toolbox.md", "source_location": "Observer (toolbox serve)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pull, read-only, observe-don't-gate: a localhost-only web panel (disk -> fs.watch -> SSE -> browser) with hard 127.0.0.1 bind, Host-header check, GET-only, registry as read allowlist, and React text-only rendering so harness text never becomes markup. No foreign verifier runs unless --run-verifier is passed."}, {"id": "references_toolbox_health_signals", "label": "ToolBox Health Signals", "file_type": "concept", "source_file": "handyman/references/toolbox.md", "source_location": "Health Signals", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Derived signals (INVARIANT, STALE_WIP, BEHIND, IDLE, UNREADABLE) with --today for deterministic date-relative tests; gating is opt-in via health --strict, matching the observe-don't-gate philosophy."}, {"id": "references_toolbox_heartbeat", "label": "ToolBox Heartbeat (post_run closure event)", "file_type": "concept", "source_file": "handyman/references/toolbox.md", "source_location": "Heartbeat as a post_run Hook", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A drop-in post_run hook appending closure events to events.jsonl; feature done treats a failing post_run step as a warning, so a missing toolBox script never blocks a verified closure. timeline merges events with history, preferring history on collisions."}, {"id": "references_toolbox_bm25_search", "label": "Client-Side BM25 Search (observer #/search)", "file_type": "concept", "source_file": "handyman/references/toolbox.md", "source_location": "Observer (toolbox serve)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deliberately client-side retrieval: the RAG analysis concluded the harness corpus needs no server-side RAG pipeline \u2014 a BM25 index (MiniSearch) rebuilt from disk in milliseconds is immune to staleness, and agents keep using agentic search."}], "edges": [{"source": "references_toolbox", "target": "references_toolbox_registry", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "handyman/references/toolbox.md", "source_location": null, "weight": 1.0}, {"source": "references_toolbox", "target": "references_toolbox_observer", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "handyman/references/toolbox.md", "source_location": null, "weight": 1.0}, {"source": "references_toolbox", "target": "references_toolbox_health_signals", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "handyman/references/toolbox.md", "source_location": null, "weight": 1.0}, {"source": "references_toolbox", "target": "references_toolbox_heartbeat", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "handyman/references/toolbox.md", "source_location": null, "weight": 1.0}, {"sour