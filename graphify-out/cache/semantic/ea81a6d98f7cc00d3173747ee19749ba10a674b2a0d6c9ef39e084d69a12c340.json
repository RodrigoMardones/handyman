{"nodes": [{"id": "references_discovery", "label": "references/discovery.md (Skills/Agents Discovery)", "file_type": "document", "source_file": "handyman/references/discovery.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_discovery", "label": "Skill, MCP, and Agent Discovery", "file_type": "document", "source_file": "handyman/references/discovery.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_discovery_progressive_disclosure", "label": "Progressive Disclosure (skill loading)", "file_type": "concept", "source_file": "handyman/references/discovery.md", "source_location": "How the platform discovers skills and MCPs", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only a skill's name and description sit in context; the body loads when the task matches. The description is therefore the trigger: a skill that describes itself poorly is simply not found."}, {"id": "references_discovery_discovery_block", "label": "discovery Block In harness.config.json", "file_type": "concept", "source_file": "handyman/references/discovery.md", "source_location": "The discovery block", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The block records names, never paths: names are portable intent that travels with the repo, while paths are machine-specific and resolved at query time. Deliver the path, do not store it. It is optional and global because skills/MCPs/agents are mostly cross-role."}, {"id": "references_discovery_tools_discovery_cli", "label": "tools_discovery CLI (list/find/check/declare)", "file_type": "concept", "source_file": "handyman/references/discovery.md", "source_location": "Querying deterministically", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The reproducible counterpart of the host's semantic discovery: skill roots scan local-first-then-global so a vendored skill shadows a global one; check gates on missing skills/agents but only NOTEs absent MCP servers because MCP availability is host-defined."}, {"id": "references_discovery_deterministic_vs_semantic", "label": "Deterministic vs Semantic Discovery Boundary", "file_type": "rationale", "source_file": "handyman/references/discovery.md", "source_location": "Deterministic vs semantic: the boundary", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Handyman does not replace the platform's semantic discovery but wraps it in a declared, verifiable contract: the discovery block plus schemas plus the CLI are deterministic; the actual skill trigger and tool_search similarity stay semantic. The harness can declare and verify presence but cannot force a trigger."}, {"id": "references_discovery_consultation_agents", "label": "Consultation Agents (declared subagents)", "file_type": "concept", "source_file": "handyman/references/discovery.md", "source_location": "Consultation agents", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Declaring role files under discovery.agents turns a prose expectation into a verifiable contract: because a role file is a document on disk, a declared agent is checked as reliably as a skill \u2014 the honest difference from MCP, which is only a NOTE."}], "edges": [{"source": "references_discovery", "target": "references_discovery_progressive_disclosure", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "handyman/references/discovery.md", "source_location": null, "weight": 1.0}, {"source": "references_discovery", "target": "references_discovery_discovery_block", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "handyman/references/discovery.md", "source_location": null, "weight": 1.0}, {"source": "