{"nodes": [{"id": "references_evals", "label": "references/evals.md (Trigger Evals)", "file_type": "document", "source_file": "handyman/references/evals.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_evals", "label": "Trigger Evaluation", "file_type": "document", "source_file": "handyman/references/evals.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_evals_trigger_eval", "label": "Trigger Eval Set (evals/trigger-eval.json)", "file_type": "concept", "source_file": "handyman/references/evals.md", "source_location": "The eval set", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A balanced set of labeled queries with negatives written as near-misses: near-misses share vocabulary with the skill but ask for something else, which is what catches a description that over-triggers."}, {"id": "references_evals_evals_cli", "label": "evals CLI (validate/measure)", "file_type": "concept", "source_file": "handyman/references/evals.md", "source_location": "node dist/evals.js", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "validate is offline and gates; measure needs a runner and degrades to a NOTE with exit 0 when absent, so the stochastic half never blocks CI."}, {"id": "references_evals_deterministic_vs_stochastic", "label": "Deterministic Contract vs Stochastic Measurement", "file_type": "rationale", "source_file": "handyman/references/evals.md", "source_location": "The boundary", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The eval-set contract is deterministic (same file, same answer) and safe to gate; the real trigger is model-dependent and drifts between runs, so it is measured, never asserted. Confusing the two makes the gate flaky, while leaning only on the size cap mistakes 'the description fits' for 'the description triggers'."}, {"id": "references_evals_pass_at_k", "label": "pass@k Completion Reliability", "file_type": "concept", "source_file": "handyman/references/evals.md", "source_location": "pass@k (completion reliability)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Derived from already-measured trigger rates as 1-(1-r)^k with no extra model calls; unlike a confusion matrix it exposes reliability under retry, the property that matters when the skill loads inside a long-running harness. Variance (mean +/- stddev over --runs) and a held-out split guard against noise and overfitting the wording."}, {"id": "references_evals_skill_creator", "label": "skill-creator (source of eval methodology)", "file_type": "concept", "source_file": "handyman/references/evals.md", "source_location": "Two kinds of evaluation", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "references_evals", "target": "references_evals_trigger_eval", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "handyman/references/evals.md", "source_location": null, "weight": 1.0}, {"source": "references_evals", "target": "references_evals_evals_cli", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "handyman/references/evals.md", "source_location": null, "weight": 1.0}, {"source": "references_evals", "target": "references_evals_deterministic_vs_stochastic", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "handyman/references/evals.md", "source_location": null, "weight": 1.0}, {"source": "references_evals", "target": "references_evals_pass_at_k", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "handyman/references/evals.md", "source_location": null, "weight": 1.0}, {"source": "references_evals", "target":