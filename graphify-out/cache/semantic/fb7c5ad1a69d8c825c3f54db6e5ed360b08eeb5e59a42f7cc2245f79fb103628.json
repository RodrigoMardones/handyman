{"nodes": [{"id": "references_anatomy", "label": "references/anatomy.md (Harness Anatomy)", "file_type": "document", "source_file": "handyman/references/anatomy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_anatomy", "label": "Harness Anatomy", "file_type": "document", "source_file": "handyman/references/anatomy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_anatomy_harness_workspace", "label": "HARNESS_WORKSPACE", "file_type": "concept", "source_file": "handyman/references/anatomy.md", "source_location": "Harness Anatomy (intro)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two roots (PROJECT_ROOT vs HARNESS_WORKSPACE) separate mutable harness state from product code: local mode hides state in .handyman/, global mode moves it to $HOME/HANDYMAN/<project>, keeping the repo focused on product code while preserving one source of truth for active sessions."}, {"id": "references_anatomy_feature_list_contract", "label": "Feature List Contract (feature_list.json)", "file_type": "concept", "source_file": "handyman/references/anatomy.md", "source_location": "Feature List Contract", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A feature record is a state machine, not a timeline: the schema sets additionalProperties:false so invented date fields are rejected; chronology lives in progress/ instead. At most one feature may be in_progress; the sprint label is a partition, never a chronology."}, {"id": "references_anatomy_anti_telephone_protocol", "label": "Anti Telephone Protocol", "file_type": "rationale", "source_file": "handyman/references/anatomy.md", "source_location": "Anti Telephone Protocol", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Subagents must not return full code, diffs, or reports in chat; they write artifacts to disk and return one short reference, so information does not degrade through chat relay and the leader can audit the files directly."}, {"id": "references_anatomy_verification_contract", "label": "Verification Contract (executable verifier)", "file_type": "concept", "source_file": "handyman/references/anatomy.md", "source_location": "Verification Contract", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The verifier must be executable and fail loudly: truth comes from exit codes and schema validation, not prose. Advisory checks surface non-blocking gaps with NOTE: and never change the exit code."}, {"id": "references_anatomy_role_files", "label": "Role Files As Bridge Files", "file_type": "concept", "source_file": "handyman/references/anatomy.md", "source_location": "Recommended Role Files", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Agent/role files always live in platform-discoverable paths (.github/agents/ or .claude/agents/), never inside HARNESS_WORKSPACE, because the host only loads agents from those known paths; placing them in the workspace makes them undiscoverable and uninvocable."}], "edges": [{"source": "references_anatomy", "target": "references_anatomy_harness_workspace", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "handyman/references/anatomy.md", "source_location": null, "weight": 1.0}, {"source": "references_anatomy", "target": "references_anatomy_feature_list_contract", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "handyman/references/anatomy.md", "source_location": null, "weight": 1.0}, {"source": "references_anatomy", "target": "references_anatomy_anti_telephone_protocol", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "handyman/references/anatomy.md", "source_lo