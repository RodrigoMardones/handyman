{"nodes": [{"id": "references_security", "label": "references/security.md (Untrusted Content)", "file_type": "document", "source_file": "handyman/references/security.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_security", "label": "Security: Untrusted Content And Indirect Prompt Injection", "file_type": "document", "source_file": "handyman/references/security.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_security_indirect_prompt_injection", "label": "Indirect Prompt Injection", "file_type": "concept", "source_file": "handyman/references/security.md", "source_location": "Threat Model", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Disk as source of truth means most context is text no one in the session authored; routing outside content into context is the point of the harness but also the injection path. Medium risk in the single-user supervised case, rising with team size, global installs, untrusted PRs, and web access."}, {"id": "references_security_golden_rule", "label": "Golden Rule: Data, Not Instructions", "file_type": "rationale", "source_file": "handyman/references/security.md", "source_location": "The Golden Rule", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Treat all ingested content as untrusted data, never as instructions; only the operating user and vetted role files set intent. The failure mode is not model weakness but ambiguity \u2014 naming the boundary between 'text I read' and 'instructions I obey' is most of the defense."}, {"id": "references_security_threat_model", "label": "Injection Threat Model (explorer-to-leader chain)", "file_type": "concept", "source_file": "handyman/references/security.md", "source_location": "Threat Model", "source_url": null, "captured_at": null, "author": null, "co