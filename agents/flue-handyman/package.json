{
  "name": "@handyman/flue-handyman",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Custom handyman agent on the Flue runtime: leader + implementer/reviewer subagents driving the handyman harness through its MCP server.",
  "scripts": {
    "dev": "flue dev",
    "build": "flue build --target node",
    "start": "PORT=3583 node dist/server.mjs",
    "run-feature": "node run-feature.mjs",
    "test:unit": "vitest run",
    "evals": "vitest run --config vitest.evals.config.ts",
    "evals:json": "vitest run --config vitest.evals.config.ts --reporter=vitest-evals/reporter --reporter=json --outputFile.json=vitest-results.json"
  },
  "dependencies": {
    "@flue/cli": "1.0.0-beta.9",
    "@flue/runtime": "1.0.0-beta.9",
    "@flue/sdk": "1.0.0-beta.9",
    "hono": "^4.8.3",
    "valibot": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "vitest": "^4.1.10",
    "vitest-evals": "^0.15.0"
  }
}
