{
  "name": "@handyman/mastra-handyman",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Custom handyman agent on the Mastra runtime: leader (+ implementer/reviewer subagents) driving the handyman harness through its MCP server.",
  "scripts": {
    "run-feature": "HANDYMAN_DATA_DIR=$PWD/data HANDYMAN_TELEMETRY_DIR=$PWD/logs tsx run-feature.ts",
    "run-workflow": "HANDYMAN_DATA_DIR=$PWD/data HANDYMAN_TELEMETRY_DIR=$PWD/logs tsx run-workflow.ts",
    "run-skill": "HANDYMAN_DATA_DIR=$PWD/data HANDYMAN_TELEMETRY_DIR=$PWD/logs tsx run-skill.ts",
    "build:bundle": "node scripts/build_bundle.mjs",
    "studio": "HANDYMAN_REPO_ROOT=$PWD/../.. HANDYMAN_DATA_DIR=$PWD/data HANDYMAN_TELEMETRY_DIR=$PWD/logs mastra dev -d studio -e ../../.env",
    "test:unit": "vitest run",
    "test:eval": "HANDYMAN_DATA_DIR=$PWD/data HANDYMAN_TELEMETRY_DIR=$PWD/logs tsx run-evals.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.23",
    "@mastra/core": "1.54.0",
    "@mastra/duckdb": "1.5.2",
    "@mastra/evals": "1.6.0",
    "@mastra/libsql": "1.18.0",
    "@mastra/loggers": "1.2.0",
    "@mastra/mcp": "1.15.0",
    "@mastra/memory": "1.24.0",
    "@mastra/observability": "1.16.3",
    "handyman-harness": "workspace:*",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "esbuild": "^0.28.1",
    "mastra": "1.20.3",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}