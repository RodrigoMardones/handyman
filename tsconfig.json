{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "ignoreDeprecations": "6.0",
    "skipLibCheck": true,
    "types": ["bun"],
    "noEmit": true
  },
  "include": ["bin/**/*.ts", "src/**/*.ts", "tests/**/*.ts"]
}
